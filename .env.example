# Copy to .env for local development. NEVER commit the real file.
# In production every value below is set through Vercel's environment variables.

# ---------------------------------------------------------------------------
# Database — Neon Postgres. The single source of truth for all financial data.
# Use the POOLED connection string (it ends in -pooler).
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/ledger?sslmode=require"

# ---------------------------------------------------------------------------
# Auth — generate with:  openssl rand -base64 32
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET="replace-me-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:5173"

# The public origin of the app. Used for cookies, CSP and auth callbacks.
APP_URL="http://localhost:5173"

# ---------------------------------------------------------------------------
# Storage — Supabase, for FILES only (receipts, backup archives).
# Optional: the app runs without it, and file features report as unavailable.
# Transaction data never goes here.
# ---------------------------------------------------------------------------
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="ledger-files"

# ---------------------------------------------------------------------------
# Assistant — Chillar, on Groq (console.groq.com → API Keys).
# Optional: without it, the assistant says it is not set up yet.
# ---------------------------------------------------------------------------
GROQ_API_KEY=""

# Connection pool size per instance. Leave unset for Neon.
# Set to 1 when running against the single-connection dev database
# (`npm run dev:db`).
# DB_POOL_MAX=1

# Local API port.
PORT=3001
